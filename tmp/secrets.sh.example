# Local API keys for IndustryNav.
#
# Copy this file to tmp/secrets.sh, fill in your keys, then source it before
# running any LLM benchmark:
#
#   cp tmp/secrets.sh.example tmp/secrets.sh
#   chmod 600 tmp/secrets.sh
#   source tmp/secrets.sh
#
# tmp/secrets.sh is gitignored. Never commit real keys.
# The A*, BC, and random baselines run offline and need no keys.

# Required for BASELINE=llm (OpenRouter models).
export OPENROUTER_API_KEY="sk-or-..."

# Optional: only needed when using the direct Gemini provider.
# export GEMINI_API_KEY="..."
